name: vnu spiegeln (feste Version im eigenen Release)
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  spiegeln:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.12"
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "21"
      - name: vnu.jar prüfen, spiegeln und Sperrdatei aktualisieren
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
        run: python tools/mirror_vnu.py
      - name: Sperrdatei hochladen
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add src/claudios/components/components.lock.json
          git diff --cached --quiet || (git commit -m "Pin vnu to a mirrored fixed release" && git push)
